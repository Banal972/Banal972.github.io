---
import Base from '~/layouts/Base.astro';
import TaxonomyList from '~/components/TaxonomyList.astro';
import { countBy, getPosts, slugify } from '~/lib/posts';

const posts = await getPosts();
const items = countBy(posts, (p) => p.data.tags).map((t) => ({
  ...t,
  label: `#${t.name}`,
  href: `/tags/${slugify(t.name)}/`,
}));
---

<Base title="태그" description="Banal.log 의 글을 태그별로 모아봤습니다.">
  <section class="container page-head">
    <p class="eyebrow">Tags</p>
    <h1>태그</h1>
    <p class="sub">{items.length}개 태그</p>
  </section>

  <section class="container">
    <TaxonomyList items={items} variant="pill" />
  </section>
</Base>

<style>
  .page-head {
    padding-block: clamp(2.5rem, 6vw, 4rem) 2rem;
  }

  .page-head h1 {
    margin-top: 0.5rem;
    font-size: clamp(1.75rem, 5vw, 2.5rem);
  }

  .sub {
    margin-top: 0.65rem;
    color: var(--text-muted);
    font-size: 0.9375rem;
  }
</style>
