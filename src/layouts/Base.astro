---
import BaseHead from '~/components/BaseHead.astro';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import SearchDialog from '~/components/SearchDialog.astro';
import { SITE } from '~/consts';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedAt?: Date;
  updatedAt?: Date;
  noindex?: boolean;
  schema?: unknown;
}
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <BaseHead {...Astro.props} />
  </head>
  <body>
    <a class="skip" href="#main">본문으로 건너뛰기</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <SearchDialog />

    <style>
      .skip {
        position: fixed;
        top: 0.5rem;
        left: 0.5rem;
        z-index: 100;
        padding: 0.5rem 0.9rem;
        border-radius: var(--radius-sm);
        background: var(--text);
        color: var(--bg);
        font-size: 0.875rem;
        transform: translateY(-200%);
      }

      .skip:focus {
        transform: none;
      }
    </style>
  </body>
</html>
