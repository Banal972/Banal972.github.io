---
import Base from '~/layouts/Base.astro';
import { categoryLabel, getPosts, postUrl, primaryCategory } from '~/lib/posts';

const posts = await getPosts();

// 연도별로 묶어 최신 연도부터 보여준다.
const byYear = new Map<number, typeof posts>();
for (const post of posts) {
  const year = post.data.date.getFullYear();
  byYear.set(year, [...(byYear.get(year) ?? []), post]);
}
const years = [...byYear.entries()].sort((a, b) => b[0] - a[0]);

const monthDay = new Intl.DateTimeFormat('ko-KR', {
  month: '2-digit',
  day: '2-digit',
  timeZone: 'Asia/Seoul',
});
---

<Base title="아카이브" description={`Banal.log 의 글 ${posts.length}편을 연도별로 정리했습니다.`}>
  <section class="container container--narrow page-head">
    <p class="eyebrow">Archives</p>
    <h1>아카이브</h1>
    <p class="sub">{posts.length}편</p>
  </section>

  <section class="container container--narrow">
    {
      years.map(([year, list]) => (
        <div class="year">
          <h2>
            {year}
            <span class="year-count">{list.length}</span>
          </h2>
          <ul>
            {list.map((post) => (
              <li>
                <a href={postUrl(post)}>
                  <time datetime={post.data.date.toISOString()}>
                    {monthDay.format(post.data.date).replace(/\.$/, '')}
                  </time>
                  <span class="title">{post.data.title}</span>
                  <span class="cat">{categoryLabel(primaryCategory(post))}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </section>
</Base>

<style>
  .page-head {
    padding-block: clamp(2.5rem, 6vw, 4rem) 2rem;
  }

  .page-head h1 {
    margin-top: 0.5rem;
    font-size: clamp(1.75rem, 5vw, 2.5rem);
  }

  .sub {
    margin-top: 0.65rem;
    color: var(--text-muted);
    font-size: 0.9375rem;
  }

  .year + .year {
    margin-top: 2.75rem;
  }

  .year h2 {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--line);
    font-size: 1.25rem;
    font-variant-numeric: tabular-nums;
  }

  .year-count {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--text-muted);
  }

  ul {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
  }

  li a {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.9rem;
    padding: 0.7rem 0.6rem;
    margin-inline: -0.6rem;
    border-radius: var(--radius-sm);
    transition: background 0.15s ease;
  }

  li a:hover {
    background: var(--surface-hover);
  }

  time {
    font-size: 0.8125rem;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .title {
    font-size: 0.9375rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .cat {
    font-size: 0.75rem;
    color: var(--accent-text);
    font-weight: 600;
  }

  @media (max-width: 560px) {
    li a {
      grid-template-columns: 3.2rem minmax(0, 1fr);
    }

    .cat {
      display: none;
    }
  }
</style>
