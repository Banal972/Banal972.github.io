---
import Thumb from '~/components/Thumb.astro';
import {
  categoryLabel,
  excerpt,
  formatDateShort,
  isoDate,
  postUrl,
  primaryCategory,
  readingTime,
  type Post,
} from '~/lib/posts';

interface Props {
  post: Post;
  variant?: 'grid' | 'featured';
  eager?: boolean;
}

const { post, variant = 'grid', eager = false } = Astro.props;
const category = primaryCategory(post);
---

<article class:list={['card', `card--${variant}`]}>
  <a class="card-link" href={postUrl(post)}>
    <div class="card-media">
      <Thumb
        slug={post.id}
        title={post.data.title}
        category={category}
        heroImage={post.data.heroImage}
        heroAlt={post.data.heroAlt}
        eager={eager}
      />
    </div>

    <div class="card-body">
      <span class="card-category">{categoryLabel(category)}</span>
      <h3 class="card-title">{post.data.title}</h3>
      <p class="card-excerpt">{excerpt(post, variant === 'featured' ? 160 : 96)}</p>

      <div class="card-meta">
        <time datetime={isoDate(post.data.date)}>{formatDateShort(post.data.date)}</time>
        <span class="sep" aria-hidden="true">·</span>
        <span>{readingTime(post)}분</span>
        {post.data.pin && <span class="pin">고정</span>}
      </div>
    </div>
  </a>
</article>

<style>
  .card {
    position: relative;
    border-radius: var(--radius-lg);
    transition: transform 0.22s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .card:hover {
    transform: translateY(-3px);
  }

  .card-link {
    display: block;
    height: 100%;
  }

  .card-media {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius);
    box-shadow: var(--shadow-card);
    transition: box-shadow 0.22s ease;
  }

  .card:hover .card-media {
    box-shadow: var(--shadow-lift);
  }

  .card-media :global(.thumb) {
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .card:hover .card-media :global(.thumb) {
    transform: scale(1.035);
  }

  .card-body {
    padding-top: 0.95rem;
  }

  .card-category {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    color: var(--accent-text);
    margin-bottom: 0.4rem;
  }

  .card-title {
    font-size: 1.0625rem;
    line-height: 1.45;
    color: var(--text);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-excerpt {
    margin-top: 0.45rem;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--text-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.75rem;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .sep {
    opacity: 0.5;
  }

  .pin {
    margin-left: auto;
    padding: 0.1rem 0.45rem;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent-text);
    font-size: 0.6875rem;
    font-weight: 700;
  }

  /* 홈 최상단 대표 글 */
  @media (min-width: 860px) {
    .card--featured .card-link {
      display: grid;
      grid-template-columns: 1.35fr 1fr;
      gap: 2.5rem;
      align-items: center;
    }

    .card--featured .card-media :global(.thumb) {
      aspect-ratio: 16 / 9;
    }

    .card--featured .card-body {
      padding-top: 0;
    }

    .card--featured .card-title {
      font-size: 1.875rem;
      -webkit-line-clamp: 3;
      line-clamp: 3;
    }

    .card--featured .card-excerpt {
      margin-top: 0.85rem;
      font-size: 0.9375rem;
      -webkit-line-clamp: 3;
      line-clamp: 3;
    }

    .card--featured .card-category {
      font-size: 0.8125rem;
    }
  }
</style>
