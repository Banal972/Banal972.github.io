---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

// h2, h3 만 목차로 쓴다. 그보다 깊으면 사이드바가 지저분해진다.
const items = Astro.props.headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  items.length >= 2 && (
    <nav class="toc" aria-label="목차">
      <p class="toc-title">목차</p>
      <ul>
        {items.map((h) => (
          <li class:list={[`d${h.depth}`]}>
            <a href={`#${h.slug}`} data-toc-link={h.slug}>
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<style>
  .toc {
    position: sticky;
    top: calc(var(--header-h) + 2rem);
    max-height: calc(100vh - var(--header-h) - 4rem);
    overflow-y: auto;
    font-size: 0.8125rem;
    border-left: 1px solid var(--line);
    padding-left: 1.1rem;
  }

  .toc-title {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.1rem;
  }

  li.d3 {
    padding-left: 0.8rem;
  }

  a {
    display: block;
    padding: 0.28rem 0;
    color: var(--text-muted);
    line-height: 1.45;
    transition: color 0.15s ease;
  }

  a:hover {
    color: var(--text);
  }

  a.active {
    color: var(--accent-text);
    font-weight: 600;
  }
</style>

<script>
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]');
  if (links.length > 0) {
    const byId = new Map([...links].map((a) => [a.dataset.tocLink!, a]));
    const visible = new Set<string>();

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) visible.add(entry.target.id);
          else visible.delete(entry.target.id);
        }
        links.forEach((a) => a.classList.remove('active'));
        const first = [...byId.keys()].find((id) => visible.has(id));
        if (first) byId.get(first)?.classList.add('active');
      },
      { rootMargin: '-80px 0px -70% 0px' },
    );

    byId.forEach((_, id) => {
      const el = document.getElementById(id);
      if (el) observer.observe(el);
    });
  }
</script>
