---
import Base from '~/layouts/Base.astro';
---

<Base title="페이지를 찾을 수 없습니다" noindex>
  <section class="container notfound">
    <p class="code">404</p>
    <h1>페이지를 찾을 수 없습니다</h1>
    <p class="sub">주소가 바뀌었거나 삭제된 글일 수 있습니다.</p>
    <div class="actions">
      <a class="primary" href="/">홈으로</a>
      <button type="button" data-search-open>글 검색</button>
    </div>
  </section>
</Base>

<style>
  .notfound {
    display: grid;
    place-items: center;
    text-align: center;
    padding-block: clamp(5rem, 16vw, 9rem);
  }

  .code {
    font-size: clamp(3rem, 12vw, 5rem);
    font-weight: 800;
    letter-spacing: -0.05em;
    color: var(--accent);
  }

  h1 {
    margin-top: 0.5rem;
    font-size: clamp(1.25rem, 4vw, 1.75rem);
  }

  .sub {
    margin-top: 0.75rem;
    color: var(--text-muted);
  }

  .actions {
    display: flex;
    gap: 0.6rem;
    margin-top: 2rem;
  }

  .actions a,
  .actions button {
    padding: 0.6rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.9375rem;
  }

  .actions .primary {
    background: var(--text);
    border-color: var(--text);
    color: var(--bg);
    font-weight: 600;
  }
</style>
